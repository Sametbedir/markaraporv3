# Bu dosya yalnizca ornektir. Gercek degerleri .env dosyasina yaz; .env asla commit edilmez.
# Supabase Dashboard > Connect > Connection string bilgilerinden doldur.
# Runtime icin pooler URL (6543), migration icin direct URL (5432) kullan.
DATABASE_URL="postgresql://postgres.PROJE_REF:VERITABANI_SIFRESI@aws-0-BOLGE.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Uretmek icin: openssl rand -base64 32
NEXTAUTH_SECRET="buraya-rastgele-uzun-bir-deger-yaz"
AUTH_SECRET="buraya-rastgele-uzun-bir-deger-yaz"

# Gemini anahtari (istege bagli). Bos birakilirsa AI karti "servis kullanilamiyor" der.
GEMINI_API_KEY=""

# Gelistirme icin sabit demo admin girisi. Varsayilan kapali; yalnizca "true" yazilirsa
# ve NODE_ENV production degilse calisir. Gercek veritabanina admin yazmaz.
DEMO_ADMIN_ENABLED="false"

# scripts/seed.ts ve scripts/create-admin.ts icin admin bilgileri (zorunlu).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
